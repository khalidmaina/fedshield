// FedShield eBPF program (bpftrace 0.20), run by collector/collector.py.
//
// Prints one line per event, but only for processes inside a testbed host: the kernel filter
// is the UTS hostname prefix "fs-", so nothing from the machine itself or the c2-server is
// seen. Only the fields the 19 features need are printed. The collector keeps them in memory
// for one 10-second window and writes counts only: no path, address or command name ever
// reaches disk (data minimisation).
//
//   E|ns|host|comm|path          a program was started            (syscalls:sys_enter_execve)
//   O|ns|host|flags|comm|path    a file was opened                (syscalls:sys_enter_openat)
//   C|ns|host|dport|comm|daddr   an outgoing TCP connection began (sock:inet_sock_set_state -> SYN_SENT)
//   X|ns|host|comm               a PROCESS exited                 (sched:sched_process_exit, pid == tid)
//
// ns is bpftrace's nsecs (CLOCK_MONOTONIC); the collector converts it to wall-clock time.
// The free-text field (path, daddr) is always last, so a '|' inside a path cannot shift the
// other fields. Exits are counted for whole processes only: sched_process_exit fires once per
// thread, which inflated exit counts by 28% on the testbed (multi-threaded python servers).

tracepoint:syscalls:sys_enter_execve
/ strncmp(curtask->nsproxy->uts_ns->name.nodename, "fs-", 3) == 0 /
{
  printf("E|%llu|%s|%s|%s\n", nsecs, curtask->nsproxy->uts_ns->name.nodename, comm,
         str(args->filename));
}

tracepoint:syscalls:sys_enter_openat
/ strncmp(curtask->nsproxy->uts_ns->name.nodename, "fs-", 3) == 0 /
{
  printf("O|%llu|%s|%d|%s|%s\n", nsecs, curtask->nsproxy->uts_ns->name.nodename, args->flags,
         comm, str(args->filename));
}

// newstate 2 = TCP_SYN_SENT, protocol 6 = TCP, family 2 = AF_INET (10 = AF_INET6)
tracepoint:sock:inet_sock_set_state
/ args->newstate == 2 && args->protocol == 6 &&
  strncmp(curtask->nsproxy->uts_ns->name.nodename, "fs-", 3) == 0 /
{
  if (args->family == 2) {
    printf("C|%llu|%s|%d|%s|%s\n", nsecs, curtask->nsproxy->uts_ns->name.nodename, args->dport,
           comm, ntop(args->daddr));
  } else {
    printf("C|%llu|%s|%d|%s|%s\n", nsecs, curtask->nsproxy->uts_ns->name.nodename, args->dport,
           comm, ntop(args->daddr_v6));
  }
}

tracepoint:sched:sched_process_exit
/ pid == tid && strncmp(curtask->nsproxy->uts_ns->name.nodename, "fs-", 3) == 0 /
{
  printf("X|%llu|%s|%s\n", nsecs, curtask->nsproxy->uts_ns->name.nodename, comm);
}
