// FedShield eBPF collector (bpftrace).
// Emits one line per event, only for processes whose UTS hostname starts with "fs-"
// (the testbed containers). Events on the VM itself are ignored (data minimisation).
// Output format (fields separated by |):
//   EXEC|ns|host|pid|ppid|uid|comm|path
//   OPEN|ns|host|pid|0|uid|comm|path|flags
//   CONN|ns|host|pid|0|uid|comm|daddr|dport
//   EXIT|ns|host|pid|0|uid|comm

tracepoint:syscalls:sys_enter_execve
/ strncmp(curtask->nsproxy->uts_ns->name.nodename, "fs-", 3) == 0 /
{
  printf("EXEC|%llu|%s|%d|%d|%d|%s|%s\n", nsecs, curtask->nsproxy->uts_ns->name.nodename,
         pid, curtask->real_parent->tgid, uid, comm, str(args->filename));
}

tracepoint:syscalls:sys_enter_openat
/ strncmp(curtask->nsproxy->uts_ns->name.nodename, "fs-", 3) == 0 /
{
  printf("OPEN|%llu|%s|%d|0|%d|%s|%s|%d\n", nsecs, curtask->nsproxy->uts_ns->name.nodename,
         pid, uid, comm, str(args->filename), args->flags);
}

// TCP connect attempts: state change to TCP_SYN_SENT (2), protocol TCP (6)
tracepoint:sock:inet_sock_set_state
/ args->newstate == 2 && args->protocol == 6 && strncmp(curtask->nsproxy->uts_ns->name.nodename, "fs-", 3) == 0 /
{
  printf("CONN|%llu|%s|%d|0|%d|%s|%s|%d\n", nsecs, curtask->nsproxy->uts_ns->name.nodename,
         pid, uid, comm, ntop(args->daddr), args->dport);
}

tracepoint:sched:sched_process_exit
/ strncmp(curtask->nsproxy->uts_ns->name.nodename, "fs-", 3) == 0 /
{
  printf("EXIT|%llu|%s|%d|0|%d|%s\n", nsecs, curtask->nsproxy->uts_ns->name.nodename, pid, uid, comm);
}
