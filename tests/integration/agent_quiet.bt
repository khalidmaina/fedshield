// T5: the agents' own polling must add no events to the telemetry.
// Run with the testbed up and NO attack running:  sudo bpftrace tests/integration/agent_quiet.bt
// Pass: both counters are 0 after 20 seconds.
BEGIN { @open = 0; @exec = 0; }
tracepoint:syscalls:sys_enter_openat /comm == "agent.sh"/ { @open++; }
tracepoint:syscalls:sys_enter_execve /comm == "agent.sh"/ { @exec++; }
interval:s:20 { exit(); }
